# Salin file ini menjadi .env.local, lalu isi nilai lokal.
# Jangan pernah commit .env.local atau menaruh secret di file ini.

# Database
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Notifikasi
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@isli.co.id"

# Sentry
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="isli-ops"

# Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Jakarta"

# Akun uji e2e (opsional — kalau kosong, suite Playwright melakukan skip).
# Dibuat via Supabase admin API; lihat scripts/create-supabase-users.md.
E2E_TEST_EMAIL=""
E2E_TEST_PASSWORD=""

# Fase 3 — Accurate Online (belum dipakai)
# ACCURATE_CLIENT_ID=""
# ACCURATE_CLIENT_SECRET=""
# ACCURATE_REDIRECT_URI=""
# ACCURATE_DB_ID=""
