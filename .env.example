# ---------------------------------------------------------------
# Notifikasi — PWA push (gratis, menggantikan WhatsApp API)
# ---------------------------------------------------------------
# Hasilkan sekali: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@isli.co.id"

# ---------------------------------------------------------------
# Sentry — 4 user, nol tim ops. Ini mata kita saat sistem error.
# ---------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="isli-ops"

# ---------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Semua tanggal, jatuh tempo, dan cut-off memakai zona ini.
APP_TIMEZONE="Asia/Jakarta"

