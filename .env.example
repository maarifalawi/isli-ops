# Salin jadi .env.local, lalu isi. JANGAN commit .env.local.
#
# Q51/Q52/Q53 masih terbuka: akun Vercel & Supabase atas nama siapa,
# siapa pegang akses produksi, dan siapa bayar langganan.
# Sampai itu dijawab, semua ini pakai akun pribadi Alawi — sementara.

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI
# Pakai connection pooler (port 6543) untuk runtime.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Koneksi langsung (port 5432) — hanya untuk drizzle-kit migrate.
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

